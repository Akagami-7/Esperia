export component CountMetronomeWidget inherits Window {
    width: 94px;
    height: 40px;
    no-frame: true;
    background: transparent;

    in-out property <bool> countin-active: false;
    in-out property <bool> metronome-active: false;
    in property <color> surface-color: #9e9e9e;
    in property <color> hover-color: #8c8c8c;

    callback countin-toggled(bool);
    callback metronome-toggled(bool);

    private property <color> inactive-icon: #515151;
    private property <color> active-icon: #f5e8ff;

    outer-hover := TouchArea {
        width: 100%;
        height: 100%;
    }

    // Outer squircle hover container
    Rectangle {
        width: 94px;
        height: 40px;
        border-radius: 14px;
        background: outer-hover.has-hover ? root.hover-color : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    // ── Left Button: Count-In (1-2-3-4) ─────────────────────────────────────
    count-btn := Rectangle {
        x: count-touch.pressed ? 1.4px : 0px;
        y: count-touch.pressed ? 2.5px : 0px;
        width: count-touch.pressed ? 43.2px : 46px;
        height: count-touch.pressed ? 37.6px : 40px;
        border-radius: 14px;
        background: root.countin-active
            ? (count-touch.pressed
                ? @linear-gradient(180deg, #6e2394 0%, #7d29a7 100%)
                : @linear-gradient(180deg, #8b33b8 0%, #73259b 100%))
            : (count-touch.pressed ? #0000000e : transparent);
        drop-shadow-color: root.countin-active
            ? (count-touch.pressed ? #1905245a : #4e166c52)
            : transparent;
        drop-shadow-blur: count-touch.pressed ? 3px : 8px;
        drop-shadow-offset-y: count-touch.pressed ? 1px : 3px;
        animate width, height, x, y { duration: 70ms; easing: ease-out; }
        animate drop-shadow-blur, drop-shadow-offset-y { duration: 70ms; }

        // Top highlight hairline when active
        Rectangle {
            visible: root.countin-active && !count-touch.pressed;
            x: 12px;
            y: 0.8px;
            width: parent.width - 24px;
            height: 0.8px;
            background: #ffffff52;
        }

        // Dashed arc over the 4 bars
        Path {
            width: 46px;
            height: 40px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 46;
            viewbox-height: 40;
            stroke: root.countin-active ? #f5e8ff73 : #51515173;
            stroke-width: 1.5px;
            fill: transparent;
            commands: "M 11.5 19.5 C 15.5 13.5 23.5 10.0 32.5 9.5";
        }

        // 4 rising count-in bars
        Rectangle {
            x: 10.5px;
            y: 23px;
            width: 3.8px;
            height: 6px;
            border-radius: 2px;
            background: root.countin-active ? #f5e8ff80 : #51515180;
        }
        Rectangle {
            x: 17.5px;
            y: 19.5px;
            width: 3.8px;
            height: 9.5px;
            border-radius: 2px;
            background: root.countin-active ? #f5e8ffb3 : #515151b3;
        }
        Rectangle {
            x: 24.5px;
            y: 16px;
            width: 3.8px;
            height: 13px;
            border-radius: 2px;
            background: root.countin-active ? #f5e8ffe0 : #515151e0;
        }
        Rectangle {
            x: 31.5px;
            y: 12px;
            width: 4.2px;
            height: 17px;
            border-radius: 2px;
            background: root.countin-active ? #ffffff : #515151;
        }

        count-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.countin-active = !root.countin-active;
                root.countin-toggled(root.countin-active);
            }
        }
    }

    // ── Right Button: Metronome ──────────────────────────────────────────────
    metro-btn := Rectangle {
        x: 48px + (metro-touch.pressed ? 1.4px : 0px);
        y: metro-touch.pressed ? 2.5px : 0px;
        width: metro-touch.pressed ? 43.2px : 46px;
        height: metro-touch.pressed ? 37.6px : 40px;
        border-radius: 14px;
        background: root.metronome-active
            ? (metro-touch.pressed
                ? @linear-gradient(180deg, #6e2394 0%, #7d29a7 100%)
                : @linear-gradient(180deg, #8b33b8 0%, #73259b 100%))
            : (metro-touch.pressed ? #0000000e : transparent);
        drop-shadow-color: root.metronome-active
            ? (metro-touch.pressed ? #1905245a : #4e166c52)
            : transparent;
        drop-shadow-blur: metro-touch.pressed ? 3px : 8px;
        drop-shadow-offset-y: metro-touch.pressed ? 1px : 3px;
        animate width, height, x, y { duration: 70ms; easing: ease-out; }
        animate drop-shadow-blur, drop-shadow-offset-y { duration: 70ms; }

        Rectangle {
            visible: root.metronome-active && !metro-touch.pressed;
            x: 12px;
            y: 0.8px;
            width: parent.width - 24px;
            height: 0.8px;
            background: #ffffff52;
        }

        // Center beat dot + stem
        Rectangle {
            x: 20.9px;
            y: 8.1px;
            width: 4.2px;
            height: 4.2px;
            border-radius: 2.1px;
            background: root.metronome-active ? root.active-icon : root.inactive-icon;
        }
        Rectangle {
            x: 20.9px;
            y: 14.2px;
            width: 4.2px;
            height: 14.8px;
            border-radius: 2px;
            background: root.metronome-active ? root.active-icon : root.inactive-icon;
        }

        // Inner & outer acoustic wave arcs
        Path {
            width: 46px;
            height: 40px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 46;
            viewbox-height: 40;
            stroke: root.metronome-active ? #f5e8ffd9 : #515151d9;
            stroke-width: 2px;
            fill: transparent;
            commands: "M 16.2 17.1 C 14.4 19.5 14.4 23.7 16.2 26.1 M 29.8 17.1 C 31.6 19.5 31.6 23.7 29.8 26.1";
        }
        Path {
            width: 46px;
            height: 40px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 46;
            viewbox-height: 40;
            stroke: root.metronome-active ? #f5e8ff73 : #51515173;
            stroke-width: 1.6px;
            fill: transparent;
            commands: "M 12.0 14.6 C 9.4 18.4 9.4 24.8 12.0 28.6 M 34.0 14.6 C 36.6 18.4 36.6 24.8 34.0 28.6";
        }

        metro-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.metronome-active = !root.metronome-active;
                root.metronome-toggled(root.metronome-active);
            }
        }
    }
}
